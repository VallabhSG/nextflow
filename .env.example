# --- Database (Neon PostgreSQL) ---
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# --- Clerk Authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# --- Google AI Studio (Gemini) ---
GEMINI_API_KEY=""
# Optional: override the model id
GEMINI_MODEL="gemini-3.1-pro"

# --- Trigger.dev ---
# When unset, executions fall back to in-process dev mode.
TRIGGER_SECRET_KEY=""
TRIGGER_PROJECT_REF=""

# --- Transloadit (image uploads) ---
# When unset, uploads fall back to inline data URLs.
TRANSLOADIT_AUTH_KEY=""
TRANSLOADIT_AUTH_SECRET=""
TRANSLOADIT_TEMPLATE_ID=""

# --- Spec requirement: console.log on initial render ---
NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/in/your-profile"
